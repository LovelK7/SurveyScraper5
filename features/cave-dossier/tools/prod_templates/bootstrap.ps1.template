# cavedossier PROD bootstrap v@VERSION@ (Windows PowerShell 5.1)
# Generated by SurveyScraper5/features/cave-dossier/tools/build_prod.py -
# do not edit on the Drive; changes go into the repo template and ship as a
# new version. Shared by every cavedossier_*_v@VERSION@.bat launcher.
#
# What it does on each double-click:
#   1. readable console (TrueType font - also fixes Croatian glyphs), run log
#   2. find the society archive root (probe upward for !Speleo_baza_SUE_*.xlsm)
#   3. first run / newer bundle.zip: install to %LOCALAPPDATA%\CaveDossier\v@VERSION@
#      (Python 3.11+ check, extract bundle, venv, pip install
#      .[osz,photos,geo,karta] + playwright chromium, copy podaci\geo locally,
#      generate .env with the derived LOCAL_DRIVE_ROOT + shared georef login)
#   4. ask for the Redni broj (unless arguments were passed) and run the command
# Everything (setup steps, pip, the command, stderr) is mirrored into
# %LOCALAPPDATA%\CaveDossier\logs\ - one file per run, path printed at the end.
param(
    [Parameter(Mandatory=$true)][string]$Version,
    [Parameter(Mandatory=$true)][string]$Command,
    [string]$ExtraArgs = ''
)

$ErrorActionPreference = 'Stop'

# -- run log: everything W/Run-Logged emit lands here too ----------------
$script:LogFile = $null
try {
    $logDir = Join-Path $env:LOCALAPPDATA 'CaveDossier\logs'
    New-Item -ItemType Directory -Force -Path $logDir | Out-Null
    $script:LogFile = Join-Path $logDir ("{0}_v{1}_{2}.log" -f $Command, $Version, (Get-Date -Format 'yyyyMMdd_HHmmss'))
    # keep the newest 60 logs so the folder never grows unbounded
    Get-ChildItem -Path $logDir -Filter '*.log' -File |
        Sort-Object LastWriteTime -Descending | Select-Object -Skip 60 |
        Remove-Item -Force -ErrorAction SilentlyContinue
} catch { $script:LogFile = $null }

function W([string]$Text) {
    Write-Host $Text
    if ($script:LogFile) {
        try { Add-Content -LiteralPath $script:LogFile -Value $Text -Encoding UTF8 } catch { }
    }
}

function Run-Logged([string]$Exe, [string[]]$Arguments) {
    # Merge stderr and tee every line to the log. EA must be Continue here:
    # under Stop, PS 5.1 turns redirected native stderr into terminating
    # NativeCommandError records.
    $prev = $ErrorActionPreference
    $ErrorActionPreference = 'Continue'
    & $Exe @Arguments 2>&1 | ForEach-Object {
        if ($_ -is [System.Management.Automation.ErrorRecord]) {
            $line = $_.Exception.Message
        } else {
            $line = [string]$_
        }
        Write-Host $line
        if ($script:LogFile) {
            try { Add-Content -LiteralPath $script:LogFile -Value $line -Encoding UTF8 } catch { }
        }
    }
    $code = $LASTEXITCODE
    $ErrorActionPreference = $prev
    return $code
}

function Pause-Exit([int]$Code) {
    W ''
    if ($script:LogFile) { W "Zapis ovog pokretanja: $script:LogFile" }
    if ($Code -ne 0) { W 'Kod problema posalji tu datoteku razvijatelju.' }
    Write-Host ''
    Read-Host 'Pritisni Enter za izlaz' | Out-Null
    exit $Code
}

# -- readable console: a TrueType font also renders s/c/z with diacritics --
# (a raster-font window shows tiny text AND mangles UTF-8 glyphs). Fail-soft:
# inside Windows Terminal the call is simply ignored.
function Set-ConsoleFont([string]$Face, [int]$Size) {
    try {
        Add-Type -TypeDefinition @'
using System;
using System.Runtime.InteropServices;
public static class CaveDossierConsoleFont {
    [StructLayout(LayoutKind.Sequential, CharSet = CharSet.Unicode)]
    public struct CONSOLE_FONT_INFO_EX {
        public uint cbSize;
        public uint nFont;
        public short dwFontSizeX;
        public short dwFontSizeY;
        public int FontFamily;
        public int FontWeight;
        [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 32)]
        public string FaceName;
    }
    [DllImport("kernel32.dll", SetLastError = true)]
    public static extern IntPtr GetStdHandle(int nStdHandle);
    [DllImport("kernel32.dll", SetLastError = true, CharSet = CharSet.Unicode)]
    public static extern bool SetCurrentConsoleFontEx(
        IntPtr hConsoleOutput, bool bMaximumWindow, ref CONSOLE_FONT_INFO_EX info);
    public static void Apply(string face, short size) {
        CONSOLE_FONT_INFO_EX info = new CONSOLE_FONT_INFO_EX();
        info.cbSize = (uint)Marshal.SizeOf(info);
        info.FaceName = face;
        info.dwFontSizeX = 0;
        info.dwFontSizeY = size;
        info.FontFamily = 54;   // FF_MODERN | TMPF_TRUETYPE
        info.FontWeight = 400;
        SetCurrentConsoleFontEx(GetStdHandle(-11), false, ref info);
    }
}
'@
        [CaveDossierConsoleFont]::Apply($Face, [int16]$Size)
    } catch { }
}

try {
    Set-ConsoleFont 'Consolas' 20

    # Command id -> cavedossier argv + operator label. A new prod command needs
    # a branch here AND an entry in build_prod.py PROD_COMMANDS.
    switch ($Command) {
        'osz_prefill' {
            $cliVerb = @('osz', 'prefill')
            $label = 'OSZ prefill - predispunjeni zapisnik za objekt (SB + karta + lokacija/kota)'
        }
        'photos_process' {
            $cliVerb = @('photos', 'process')
            $label = 'Obrada fotografija ulaza - smanjene kopije SB_<broj>_<Ime>_<Autor>_<n>.jpg'
        }
        default {
            W "GRESKA: nepoznata naredba '$Command'."
            Pause-Exit 1
        }
    }

    W "=== cavedossier $($cliVerb -join ' ')  (v$Version) ==="
    W $label
    W ("racunalo: {0}  korisnik: {1}  vrijeme: {2}" -f $env:COMPUTERNAME, $env:USERNAME, (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'))
    W ''

    # -- locate the archive root -----------------------------------------
    # This script sits in <arhiva>\!!!Digitalizacija\SurveyScraper5\v<X>\.
    # Probing upward for the SB workbook beats counting levels: it survives
    # the SurveyScraper5 folder being moved within the archive.
    $ss5Dir = Split-Path -Parent $PSScriptRoot
    $driveRoot = $null
    $probe = $ss5Dir
    for ($i = 0; ($i -lt 6) -and $probe; $i++) {
        $hit = Get-ChildItem -Path $probe -Filter '!Speleo_baza_SUE_*.xlsm' -File -ErrorAction SilentlyContinue
        if ($hit) { $driveRoot = $probe; break }
        $probe = Split-Path -Parent $probe
    }
    if (-not $driveRoot) {
        W 'GRESKA: ne mogu pronaci korijen arhive (mapu koja sadrzi !Speleo_baza_SUE_*.xlsm).'
        W "Trazio sam prema gore od: $ss5Dir"
        W 'Je li Google Drive za radnu povrsinu pokrenut i sinkroniziran?'
        Pause-Exit 1
    }

    $installDir = Join-Path $env:LOCALAPPDATA "CaveDossier\v$Version"
    $venvPy     = Join-Path $installDir '.venv\Scripts\python.exe'
    $cli        = Join-Path $installDir '.venv\Scripts\cavedossier.exe'
    $bundleZip  = Join-Path $PSScriptRoot 'bundle.zip'
    $stampFile  = Join-Path $installDir '.installed_stamp'

    if (-not (Test-Path $bundleZip)) {
        W "GRESKA: nedostaje $bundleZip - mapa v$Version na Driveu je nepotpuna."
        Pause-Exit 1
    }

    # -- first run / updated bundle -> (re)install -----------------------
    $bundleStamp = (Get-Item $bundleZip).LastWriteTimeUtc.Ticks.ToString()
    $installedStamp = ''
    if (Test-Path $stampFile) {
        $installedStamp = [string](Get-Content $stampFile -TotalCount 1 -ErrorAction SilentlyContinue)
    }
    $needSetup = $false
    if (-not (Test-Path $cli)) {
        $needSetup = $true
        W 'Prva priprema na ovom racunalu - jednokratno, traje nekoliko minuta'
        W '(potreban je internet). Sljedeci put naredba krece odmah.'
    } elseif ($installedStamp -ne $bundleStamp) {
        $needSetup = $true
        W 'Na Driveu je noviji paket ove verzije - obnavljam lokalnu instalaciju...'
    }

    if ($needSetup) {
        W "Instalacija: $installDir"
        W ''

        # Python >= 3.11 (probes run through cmd so launcher noise stays quiet)
        $python = $null
        foreach ($cand in @('py -3.13', 'py -3.12', 'py -3.11', 'py -3', 'python')) {
            cmd /c "$cand -c ""import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)"" >nul 2>nul"
            if ($LASTEXITCODE -eq 0) { $python = $cand; break }
        }
        if (-not $python) {
            W 'GRESKA: Python 3.11 ili noviji nije pronadjen na ovom racunalu.'
            W ''
            W 'Instaliraj ga jednom (bilo koja od ove dvije opcije):'
            W '  1) https://www.python.org/downloads/  ->  Download Python'
            W '     (u instalacijskom prozoru OBAVEZNO kvacica "Add python.exe to PATH")'
            W '  2) ili u terminalu:  winget install -e --id Python.Python.3.12'
            W ''
            W 'Nakon instalacije ponovno dvoklikni ovu naredbu.'
            Pause-Exit 1
        }
        W "Python: $python"

        New-Item -ItemType Directory -Force -Path $installDir | Out-Null
        W 'Raspakiravam paket...'
        Expand-Archive -Path $bundleZip -DestinationPath $installDir -Force

        if (-not (Test-Path $venvPy)) {
            W 'Stvaram Python okruzenje (.venv)...'
            $venvExit = Run-Logged 'cmd' @('/c', "$python -m venv ""$installDir\.venv""")
            if ($venvExit -ne 0) {
                W 'GRESKA: stvaranje .venv nije uspjelo.'
                Pause-Exit 1
            }
        }

        W 'Instaliram pakete (pip; ovo je najduzi korak)...'
        Push-Location $installDir
        $pipExit = Run-Logged $venvPy @('-m', 'pip', 'install', '--disable-pip-version-check', '-e', '.[osz,photos,geo,karta]')
        Pop-Location
        if ($pipExit -ne 0) {
            W ''
            W 'GRESKA: pip instalacija nije uspjela. Najcesci uzrok: nema interneta.'
            W 'Provjeri vezu i ponovno dvoklikni naredbu - nastavlja gdje je stala.'
            Pause-Exit 1
        }

        # Browser for the isjecak karte (georef.hr) flow - prod machines run it
        # themselves since v1.2 (user, 2026-09-02). A failed download is not
        # fatal: prefill degrades to its "excerpt not collected" note.
        W 'Preuzimam preglednik za isjecak karte (~150 MB, jednokratno)...'
        $pwExit = Run-Logged $venvPy @('-m', 'playwright', 'install', 'chromium')
        if ($pwExit -ne 0) {
            W 'UPOZORENJE: preuzimanje preglednika nije uspjelo - isjecak karte se'
            W 'nece moci dohvacati s ovog racunala. Sve ostalo radi normalno;'
            W 'sljedeca prva priprema (nova verzija) pokusat ce ponovno.'
        }

        # Local copy of the shared geodata (locality + elevation finders).
        # robocopy /XO = incremental; a rerun after an interrupted copy heals.
        $geoSrc = Join-Path $ss5Dir 'podaci\geo'
        if (Test-Path $geoSrc) {
            W 'Kopiram geopodatke s Drivea (~280 MB, jednokratno)...'
            $roboExit = Run-Logged 'robocopy' @($geoSrc, (Join-Path $installDir 'data\geo'), '/E', '/XO', '/R:2', '/W:5', '/NJH', '/NJS', '/NDL', '/NFL', '/NP')
            if ($roboExit -ge 8) {
                W 'UPOZORENJE: kopiranje geopodataka nije proslo u cijelosti -'
                W 'lokacija i kota mozda nece biti ispunjene. Ostalo radi normalno.'
            }
        } else {
            W "UPOZORENJE: $geoSrc ne postoji - preskacem geopodatke."
        }

        Set-Content -Path $stampFile -Value $bundleStamp -Encoding Ascii
        W 'Priprema gotova.'
        W ''
    }

    # -- .env: per-machine facts, regenerated whenever missing -----------
    $envFile = Join-Path $installDir '.env'
    if (-not (Test-Path $envFile)) {
        New-Item -ItemType Directory -Force -Path (Join-Path $installDir 'sb-fallback') | Out-Null
        $envLines = @(
            '# Generirano automatski (bootstrap.ps1) - po potrebi obrisi pa se stvara iznova.',
            "LOCAL_DRIVE_ROOT=$driveRoot",
            '# Lokalna rezervna kopija SB - cita se kad je radna knjiga zauzeta/nedostupna.',
            'SB_SANDBOX_PATH=sb-fallback/SB_kopija.xlsm'
        )
        # Shared society georef.hr login (injected at build time from the dev
        # .env) so `osz prefill` can collect a missing isjecak karte itself.
        $georefUrl = '@GEOREF_BASE_URL@'
        if ($georefUrl.Length -gt 0) {
            $envLines += '# georef.hr - zajednicki racun drustva (za isjecak karte).'
            $envLines += "GEOREF_BASE_URL=$georefUrl"
            $envLines += 'GEOREF_USERNAME=@GEOREF_USERNAME@'
            $envLines += 'GEOREF_PASSWORD=@GEOREF_PASSWORD@'
        }
        Set-Content -Path $envFile -Value $envLines -Encoding Ascii
    }

    # -- gather arguments and run ----------------------------------------
    $cliArgs = @()
    if ($ExtraArgs.Trim().Length -gt 0) {
        $cliArgs = $ExtraArgs.Trim() -split '\s+'
    }
    if ($cliArgs.Count -eq 0) {
        $broj = Read-Host 'Upisi Redni broj objekta iz SB (npr. 1220)'
        $broj = $broj.Trim()
        if ($broj -match '^(?i)SB[_ ]*(\d+)$') { $broj = $Matches[1] }
        if ($broj -notmatch '^\d+$') {
            W "GRESKA: '$broj' nije Redni broj (ocekujem znamenke, npr. 1220)."
            Pause-Exit 1
        }
        if ($script:LogFile) {
            try { Add-Content -LiteralPath $script:LogFile -Value "Redni broj: $broj" -Encoding UTF8 } catch { }
        }
        $cliArgs = @($broj)
    }

    $env:PYTHONIOENCODING = 'utf-8'
    W ''
    Push-Location $installDir
    $code = Run-Logged $cli ($cliVerb + $cliArgs)
    Pop-Location

    W ''
    if ($code -eq 99) {
        W 'Naredba je zavrsila s GRESKOM (kod 99) - poruke su iznad.'
    } else {
        W "Gotovo (izlazni kod $code)."
    }
    Pause-Exit $code
}
catch {
    W ''
    W "NEOCEKIVANA GRESKA: $($_.Exception.Message)"
    W $_.ScriptStackTrace
    Pause-Exit 1
}
