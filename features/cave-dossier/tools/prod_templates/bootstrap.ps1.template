# cavedossier PROD bootstrap v@VERSION@ (Windows PowerShell 5.1)
# Generated by SurveyScraper5/features/cave-dossier/tools/build_prod.py -
# do not edit on the Drive; changes go into the repo template and ship as a
# new version. Shared by every cavedossier_*_v@VERSION@.bat launcher.
#
# What it does on each double-click:
#   1. find the society archive root (probe upward for !Speleo_baza_SUE_*.xlsm)
#   2. first run / newer bundle.zip: install to %LOCALAPPDATA%\CaveDossier\v@VERSION@
#      (Python 3.11+ check, extract bundle, venv, pip install .[osz,photos,geo],
#      copy podaci\geo locally, generate .env with the derived LOCAL_DRIVE_ROOT)
#   3. ask for the Redni broj (unless arguments were passed) and run the command
param(
    [Parameter(Mandatory=$true)][string]$Version,
    [Parameter(Mandatory=$true)][string]$Command,
    [string]$ExtraArgs = ''
)

$ErrorActionPreference = 'Stop'

function Pause-Exit([int]$Code) {
    Write-Host ''
    Read-Host 'Pritisni Enter za izlaz' | Out-Null
    exit $Code
}

try {
    # Command id -> cavedossier argv + operator label. A new prod command needs
    # a branch here AND an entry in build_prod.py PROD_COMMANDS.
    switch ($Command) {
        'osz_prefill' {
            $cliVerb = @('osz', 'prefill')
            $label = 'OSZ prefill - predispunjeni zapisnik za objekt (SB + karta + lokacija/kota)'
        }
        'photos_process' {
            $cliVerb = @('photos', 'process')
            $label = 'Obrada fotografija ulaza - smanjene kopije SB_<broj>_<Ime>_<Autor>_<n>.jpg'
        }
        default {
            Write-Host "GRESKA: nepoznata naredba '$Command'."
            Pause-Exit 1
        }
    }

    Write-Host "=== cavedossier $($cliVerb -join ' ')  (v$Version) ==="
    Write-Host $label
    Write-Host ''

    # -- locate the archive root -----------------------------------------
    # This script sits in <arhiva>\!!!Digitalizacija\SurveyScraper5\v<X>\.
    # Probing upward for the SB workbook beats counting levels: it survives
    # the SurveyScraper5 folder being moved within the archive.
    $ss5Dir = Split-Path -Parent $PSScriptRoot
    $driveRoot = $null
    $probe = $ss5Dir
    for ($i = 0; ($i -lt 6) -and $probe; $i++) {
        $hit = Get-ChildItem -Path $probe -Filter '!Speleo_baza_SUE_*.xlsm' -File -ErrorAction SilentlyContinue
        if ($hit) { $driveRoot = $probe; break }
        $probe = Split-Path -Parent $probe
    }
    if (-not $driveRoot) {
        Write-Host 'GRESKA: ne mogu pronaci korijen arhive (mapu koja sadrzi !Speleo_baza_SUE_*.xlsm).'
        Write-Host "Trazio sam prema gore od: $ss5Dir"
        Write-Host 'Je li Google Drive za radnu povrsinu pokrenut i sinkroniziran?'
        Pause-Exit 1
    }

    $installDir = Join-Path $env:LOCALAPPDATA "CaveDossier\v$Version"
    $venvPy     = Join-Path $installDir '.venv\Scripts\python.exe'
    $cli        = Join-Path $installDir '.venv\Scripts\cavedossier.exe'
    $bundleZip  = Join-Path $PSScriptRoot 'bundle.zip'
    $stampFile  = Join-Path $installDir '.installed_stamp'

    if (-not (Test-Path $bundleZip)) {
        Write-Host "GRESKA: nedostaje $bundleZip - mapa v$Version na Driveu je nepotpuna."
        Pause-Exit 1
    }

    # -- first run / updated bundle -> (re)install -----------------------
    $bundleStamp = (Get-Item $bundleZip).LastWriteTimeUtc.Ticks.ToString()
    $installedStamp = ''
    if (Test-Path $stampFile) {
        $installedStamp = [string](Get-Content $stampFile -TotalCount 1 -ErrorAction SilentlyContinue)
    }
    $needSetup = $false
    if (-not (Test-Path $cli)) {
        $needSetup = $true
        Write-Host 'Prva priprema na ovom racunalu - jednokratno, traje nekoliko minuta'
        Write-Host '(potreban je internet). Sljedeci put naredba krece odmah.'
    } elseif ($installedStamp -ne $bundleStamp) {
        $needSetup = $true
        Write-Host 'Na Driveu je noviji paket ove verzije - obnavljam lokalnu instalaciju...'
    }

    if ($needSetup) {
        Write-Host "Instalacija: $installDir"
        Write-Host ''

        # Python >= 3.11 (probes run through cmd so launcher noise stays quiet)
        $python = $null
        foreach ($cand in @('py -3.13', 'py -3.12', 'py -3.11', 'py -3', 'python')) {
            cmd /c "$cand -c ""import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)"" >nul 2>nul"
            if ($LASTEXITCODE -eq 0) { $python = $cand; break }
        }
        if (-not $python) {
            Write-Host 'GRESKA: Python 3.11 ili noviji nije pronadjen na ovom racunalu.'
            Write-Host ''
            Write-Host 'Instaliraj ga jednom (bilo koja od ove dvije opcije):'
            Write-Host '  1) https://www.python.org/downloads/  ->  Download Python'
            Write-Host '     (u instalacijskom prozoru OBAVEZNO kvacica "Add python.exe to PATH")'
            Write-Host '  2) ili u terminalu:  winget install -e --id Python.Python.3.12'
            Write-Host ''
            Write-Host 'Nakon instalacije ponovno dvoklikni ovu naredbu.'
            Pause-Exit 1
        }
        Write-Host "Python: $python"

        New-Item -ItemType Directory -Force -Path $installDir | Out-Null
        Write-Host 'Raspakiravam paket...'
        Expand-Archive -Path $bundleZip -DestinationPath $installDir -Force

        if (-not (Test-Path $venvPy)) {
            Write-Host 'Stvaram Python okruzenje (.venv)...'
            cmd /c "$python -m venv ""$installDir\.venv"""
            if ($LASTEXITCODE -ne 0) {
                Write-Host 'GRESKA: stvaranje .venv nije uspjelo.'
                Pause-Exit 1
            }
        }

        Write-Host 'Instaliram pakete (pip; ovo je najduzi korak)...'
        Push-Location $installDir
        & $venvPy -m pip install --disable-pip-version-check -e ".[osz,photos,geo]"
        $pipExit = $LASTEXITCODE
        Pop-Location
        if ($pipExit -ne 0) {
            Write-Host ''
            Write-Host 'GRESKA: pip instalacija nije uspjela. Najcesci uzrok: nema interneta.'
            Write-Host 'Provjeri vezu i ponovno dvoklikni naredbu - nastavlja gdje je stala.'
            Pause-Exit 1
        }

        # Local copy of the shared geodata (locality + elevation finders).
        # robocopy /XO = incremental; a rerun after an interrupted copy heals.
        $geoSrc = Join-Path $ss5Dir 'podaci\geo'
        if (Test-Path $geoSrc) {
            Write-Host 'Kopiram geopodatke s Drivea (~280 MB, jednokratno)...'
            robocopy $geoSrc (Join-Path $installDir 'data\geo') /E /XO /R:2 /W:5 /NJH /NJS /NDL /NFL /NP | Out-Null
            if ($LASTEXITCODE -ge 8) {
                Write-Host 'UPOZORENJE: kopiranje geopodataka nije proslo u cijelosti -'
                Write-Host 'lokacija i kota mozda nece biti ispunjene. Ostalo radi normalno.'
            }
        } else {
            Write-Host "UPOZORENJE: $geoSrc ne postoji - preskacem geopodatke."
        }

        Set-Content -Path $stampFile -Value $bundleStamp -Encoding Ascii
        Write-Host 'Priprema gotova.'
        Write-Host ''
    }

    # -- .env: per-machine facts, regenerated whenever missing -----------
    $envFile = Join-Path $installDir '.env'
    if (-not (Test-Path $envFile)) {
        New-Item -ItemType Directory -Force -Path (Join-Path $installDir 'sb-fallback') | Out-Null
        $envLines = @(
            '# Generirano automatski (bootstrap.ps1) - po potrebi obrisi pa se stvara iznova.',
            "LOCAL_DRIVE_ROOT=$driveRoot",
            '# Lokalna rezervna kopija SB - cita se kad je radna knjiga zauzeta/nedostupna.',
            'SB_SANDBOX_PATH=sb-fallback/SB_kopija.xlsm'
        )
        Set-Content -Path $envFile -Value $envLines -Encoding Ascii
    }

    # -- gather arguments and run ----------------------------------------
    $cliArgs = @()
    if ($ExtraArgs.Trim().Length -gt 0) {
        $cliArgs = $ExtraArgs.Trim() -split '\s+'
    }
    if ($cliArgs.Count -eq 0) {
        $broj = Read-Host 'Upisi Redni broj objekta iz SB (npr. 1220)'
        $broj = $broj.Trim()
        if ($broj -match '^(?i)SB[_ ]*(\d+)$') { $broj = $Matches[1] }
        if ($broj -notmatch '^\d+$') {
            Write-Host "GRESKA: '$broj' nije Redni broj (ocekujem znamenke, npr. 1220)."
            Pause-Exit 1
        }
        $cliArgs = @($broj)
    }

    $env:PYTHONIOENCODING = 'utf-8'
    Write-Host ''
    Push-Location $installDir
    & $cli @cliVerb @cliArgs
    $code = $LASTEXITCODE
    Pop-Location

    Write-Host ''
    if ($code -eq 99) {
        Write-Host 'Naredba je zavrsila s GRESKOM (kod 99) - poruke su iznad.'
    } else {
        Write-Host "Gotovo (izlazni kod $code)."
    }
    Pause-Exit $code
}
catch {
    Write-Host ''
    Write-Host "NEOCEKIVANA GRESKA: $($_.Exception.Message)"
    Write-Host $_.ScriptStackTrace
    Pause-Exit 1
}
