# Copy to .env (gitignored) and fill in. Per-machine values only —
# shared configuration lives in config.yaml.

# Root of the locally synced Google Drive archive (Drive for Desktop mount).
# All config.yaml relative paths resolve against this.
# Example: LOCAL_DRIVE_ROOT=G:/My Drive/SU Estavela
LOCAL_DRIVE_ROOT=

# FALLBACK COPY: local copy of the SB workbook, read automatically when the
# live one is unreachable, open in someone's Excel, or unreadable ("SB mode:
# FALLBACK" with the reason). While live is healthy this copy is auto-refreshed
# to match it. Relative paths resolve against the feature root.
SB_SANDBOX_PATH=example/sb-sandbox/!Speleo_baza_SUE_v3.0.xlsm

# SANDBOX OVERRIDE: force every command onto a sandbox COPY ("SB mode: SANDBOX"),
# never touching live — for development / offline work. Leave unset for the
# LIVE-first behavior above. One-off live run without editing this file:
#   $env:SB_WORKBOOK_PATH=""; cavedossier sb stats
SB_WORKBOOK_PATH=

# Part 2.1c — georef.hr login for `cavedossier karta` (isječak karte).
# Same shared account crospeleo-automation uses (its .env has the values).
GEOREF_BASE_URL=
GEOREF_USERNAME=
GEOREF_PASSWORD=
# Optional: slow the browser down (ms per action) when watching with --debug.
# PLAYWRIGHT_SLOW_MO_MS=350
