# Copy to .env (gitignored) and fill in. Per-machine values only —
# shared configuration lives in config.yaml.

# Root of the locally synced Google Drive archive (Drive for Desktop mount).
# All config.yaml relative paths resolve against this.
# Example: LOCAL_DRIVE_ROOT=G:/My Drive/SU Estavela
LOCAL_DRIVE_ROOT=

# SANDBOX OVERRIDE: path to a sandbox COPY of the SB workbook. Relative paths
# resolve against the feature root (e.g. example/sb-sandbox/...) and survive
# repo renames/moves. When set, every command runs against it and prints
# "SB mode: SANDBOX". Leave unset to target the live workbook (read-only until M6).
# One-off LIVE run without editing this file:  $env:SB_WORKBOOK_PATH=""; cavedossier sb stats
SB_WORKBOOK_PATH=

# Part 2.1c — georef.hr login for `cavedossier karta` (isječak karte).
# Same shared account crospeleo-automation uses (its .env has the values).
GEOREF_BASE_URL=
GEOREF_USERNAME=
GEOREF_PASSWORD=
# Optional: slow the browser down (ms per action) when watching with --debug.
# PLAYWRIGHT_SLOW_MO_MS=350
