@echo off
rem ------------------------------------------------------------------
rem  STEP 1b (ONLY IF NEEDED) - REBUILD A BROKEN/MISSING csx FROM THE ZIP
rem  Use this when the phone's .csx is missing, 0 bytes, or lost its
rem  sketch (TopoDroid 6.4.98+ bug). Rebuilds it from the project .zip.
rem
rem    * Double-click: processes every TopoDroid project .zip under
rem      !Za digitalizirat (or under this folder, if that one is gone)
rem    * ...or drag one or more project .zip files onto this icon
rem
rem  YOU GET, next to each zip:
rem    <survey>_recovered.csx     the rebuilt phone file
rem    <survey>_recovered_pp.csx  already prepared -> IMPORT THIS ONE (STEP 3)
rem
rem  This does STEP 2 for you, so skip straight to STEP 3 afterwards.
rem  Normal case (csx is fine): you do NOT need this - use
rem  csurvey_preprocess_tdx.bat.
rem
rem  csurvey TDX kit v@VERSION@ (@DATE@, commit @COMMIT@)
rem ------------------------------------------------------------------
rem --- find the tools -----------------------------------------------
rem  Generated by prod/build_csx_kit.py -- do not edit this file. Edit
rem  prod/csx_templates/ in the repo and re-publish.
rem
rem  Rung 1 is the normal case: the .py tools sit in the @PAYLOAD@ folder
rem  beside this .bat. Rung 2 covers a flat copy (tools next to the .bat),
rem  the later rungs keep older, scattered copies alive.
set "TOOLS="
if exist "%~dp0@PAYLOAD@\tdx_zip_to_csx.py" set "TOOLS=%~dp0@PAYLOAD@"
if not defined TOOLS if exist "%~dp0tdx_zip_to_csx.py" set "TOOLS=%~dp0"
if not defined TOOLS if exist "%LOCALAPPDATA%\CsxTools\tools_path.txt" (
    for /f "usebackq delims=" %%P in ("%LOCALAPPDATA%\CsxTools\tools_path.txt") do (
        if exist "%%P\tdx_zip_to_csx.py" set "TOOLS=%%P"
    )
)
if not defined TOOLS if defined CSX_TOOLS if exist "%CSX_TOOLS%\tdx_zip_to_csx.py" set "TOOLS=%CSX_TOOLS%"
if not defined TOOLS if exist "@TOOLS@\tdx_zip_to_csx.py" set "TOOLS=@TOOLS@"
if not defined TOOLS (
    echo.
    echo  Ne mogu pronaci alate ^(nedostaje tdx_zip_to_csx.py^).
    echo  Kopiraj ponovno CIJELU mapu @PAYLOAD@ pokraj ove datoteke, iz:
    echo    @TOOLS@
    echo  ...pa probaj opet.
    echo.
    pause
    exit /b 1
)
rem --- what a double-click works on ---------------------------------
rem  The kit sits in the !!!Digitalizacija root; the surveys live in the
rem  per-cave folders under !Za digitalizirat, so scan that.
set "SCAN=%~dp0."
if exist "%~dp0@INTAKE@" set "SCAN=%~dp0@INTAKE@"
rem ------------------------------------------------------------------
echo ==================================================================
echo  STEP 1b - rebuilding csx from the project zip (recovery)
echo ==================================================================
echo.
if "%~1"=="" (
    echo  Scanning: %SCAN%
    echo.
    python "%TOOLS%\tdx_zip_to_csx.py" "%SCAN%"
) else (
    python "%TOOLS%\tdx_zip_to_csx.py" %*
)
echo.
echo ------------------------------------------------------------------
echo  NEXT (STEP 3): open the _recovered_pp.csx file in cSurvey, then
echo                 File ^> Save As, then run STEP 4
echo                 (csurvey_fix_tdx.bat).
echo ------------------------------------------------------------------
pause
