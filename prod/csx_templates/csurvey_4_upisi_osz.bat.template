@echo off
rem ------------------------------------------------------------------
rem  KORAK 4 - UPISI IZMJERU U OSZ
rem  Duljine, dubinu i dimenzije ulaza iz <ime>_dimenzije.json ^(KORAK 3^)
rem  upise u postojeci SB_<broj>_OSZ.docx u mapi objekta. Sve ostalo u
rem  zapisniku ostaje; stari primjerak cuva se kao _stari_<datum>.docx.
rem
rem  NAPRAVI POSLIJE KORAKA 3. Zapisnik mora vec postojati u mapi
rem  objekta ^(cavedossier_osz_prefill^) i ne smije biti otvoren u Wordu.
rem
rem  KAKO - dva nacina:
rem    * Dvoklik: pita Redni broj objekta
rem    * ...ili povuci bilo koju datoteku iz mape objekta na ovu ikonu -
rem      Redni broj citam iz naziva mape ^(SB_<broj>_...^)
rem
rem  Ako zapisnik vec sadrzi iste brojeve, nista se ne mijenja.
rem
rem  csurvey TDX komplet v@VERSION@ (@DATE@, commit @COMMIT@)
rem ------------------------------------------------------------------
rem  Generated by prod/build_csx_kit.py -- do not edit this file. Edit
rem  prod/csx_templates/ in the repo and re-publish.
rem ------------------------------------------------------------------
echo ==================================================================
echo  KORAK 4 - upis izmjere u OSZ (duljine, dubina, ulaz)
echo ==================================================================
echo.
if not "%~1"=="" goto :povuceno

echo  Kojem objektu upisujes izmjeru? Upisi Redni broj objekta iz Speleo
echo  baze ^(broj u nazivu mape SB_^<broj^>_...^).
echo.
echo    * prije ovoga zavrsi KORAK 3 ^(treba ..._dimenzije.json^)
echo    * zapisnik SB_^<broj^>_OSZ.docx mora biti u mapi objekta i zatvoren
echo    * samo Enter = odustani
echo.
set "SB="
set /p "SB=Redni broj: "
if not defined SB goto :odustao
echo %SB%|findstr /r "^[0-9][0-9]* *$" >nul
if errorlevel 1 goto :nijebroj
call :izmjera %SB%
goto :kraj

rem --- povucene datoteke: Redni broj iz naziva mape --------------------
:povuceno
set "BROJ="
set "MAPA="
for %%I in ("%~dp1.") do set "MAPA=%%~nxI"
for /f "tokens=1,2 delims=_" %%A in ("%MAPA%") do (
    if /i "%%A"=="SB" set "BROJ=%%B"
)
if not defined BROJ (
    echo  Ne mogu iscitati Redni broj iz naziva mape ^(ocekujem SB_^<broj^>_...^).
    echo  Pokreni dvoklikom i upisi Redni broj.
    pause
    exit /b 0
)
echo %BROJ%|findstr /r "^[0-9][0-9]* *$" >nul
if errorlevel 1 (
    echo  "%BROJ%" iz naziva mape nije Redni broj. Pokreni dvoklikom.
    pause
    exit /b 0
)
call :izmjera %BROJ%
goto :kraj

rem --- the work is a cavedossier command from this same folder -------
rem  Kit i cavedossier launcheri dijele prod mapu (prod/README.md);
rem  objavljivanje ostavlja samo najnoviju verziju vidljivom.
:izmjera
set "CDIZMJERA="
for /f "delims=" %%L in ('dir /b /o-n "%~dp0cavedossier_osz_izmjera_v*.bat" 2^>nul') do (
    if not defined CDIZMJERA set "CDIZMJERA=%~dp0%%L"
)
if not defined CDIZMJERA (
    echo  Ne mogu pronaci cavedossier_osz_izmjera_v*.bat u ovoj mapi:
    echo    %~dp0
    echo  Javi razvijatelju da u ovu mapu objavi cavedossier naredbe.
    goto :eof
)
call "%CDIZMJERA%" %1
if errorlevel 1 (
    echo.
    echo  Upis nije uspio - procitaj poruku iznad. Zapisnik nije mijenjan.
    goto :eof
)
set "IZMJERA_OK=1"
goto :eof

:kraj
echo.
echo ------------------------------------------------------------------
if defined IZMJERA_OK (
    echo  Gotovo: zapisnik u mapi objekta sada nosi duljine, dubinu i
    echo  dimenzije ulaza iz nacrta. Stari primjerak je pokraj njega
    echo  ^(_stari_^<datum^>.docx^).
) else (
    echo  Upis nije prosao - razlog je u porukama iznad.
)
echo ------------------------------------------------------------------
pause
exit /b 0

:nijebroj
echo.
echo  "%SB%" nije Redni broj. Upisi samo znamenke, npr. 1103.
echo.
pause
exit /b 0

:odustao
echo.
echo  Odustao si - nista nije promijenjeno.
echo.
pause
exit /b 0
