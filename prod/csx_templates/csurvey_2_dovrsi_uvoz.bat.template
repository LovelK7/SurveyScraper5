@echo off
rem ------------------------------------------------------------------
rem  KORAK 2 od 3 - DOVRSI UVOZ
rem  Pretvara datoteku koju si spremio u cSurveyu u gotovu datoteku za
rem  crtanje (kosine i sl. dobiju svoje strelice i crtice; velicine;
rem  voda).
rem
rem  NAPRAVI ODMAH NAKON "Save As" U cSURVEYU, PRIJE CRTANJA.
rem
rem  KAKO - dva nacina:
rem    * Dvoklik: pita Redni broj objekta, pa ponudi datoteke iz njegove
rem      mape pod !Za digitalizirat da odaberes koju dovrsiti
rem    * ...ili povuci datoteku koju si upravo spremio na ovu ikonu
rem      ^(i .csz i .csx su u redu - sto god si spremio^)
rem
rem  DOBIVAS: novu datoteku pokraj nje, imena koje zavrsava na _lt
rem       -> TU _lt datoteku otvori u cSurveyu i u njoj crtaj.
rem
rem  Ako crni prozor javi BLOCKED, odabrao si datoteku koja jos nije
rem  uvezena u cSurvey - procitaj sto ti pise.
rem
rem  csurvey TDX komplet v@VERSION@ (@DATE@, commit @COMMIT@)
rem ------------------------------------------------------------------
rem --- find the tools -----------------------------------------------
rem  Generated by prod/build_csx_kit.py -- do not edit this file. Edit
rem  prod/csx_templates/ in the repo and re-publish.
rem
rem  Rung 1 is the normal case: the .py tools sit in the @PAYLOAD@ folder
rem  beside this .bat. Rung 2 covers a flat copy (tools next to the .bat),
rem  the later rungs keep older, scattered copies alive.
set "TOOLS="
if exist "%~dp0@PAYLOAD@\fix_imported_linetypes.py" set "TOOLS=%~dp0@PAYLOAD@"
if not defined TOOLS if exist "%~dp0fix_imported_linetypes.py" set "TOOLS=%~dp0"
if not defined TOOLS if exist "%LOCALAPPDATA%\CsxTools\tools_path.txt" (
    for /f "usebackq delims=" %%P in ("%LOCALAPPDATA%\CsxTools\tools_path.txt") do (
        if exist "%%P\fix_imported_linetypes.py" set "TOOLS=%%P"
    )
)
if not defined TOOLS if defined CSX_TOOLS if exist "%CSX_TOOLS%\fix_imported_linetypes.py" set "TOOLS=%CSX_TOOLS%"
if not defined TOOLS if exist "@TOOLS@\fix_imported_linetypes.py" set "TOOLS=@TOOLS@"
if not defined TOOLS (
    echo.
    echo  Ne mogu pronaci alate ^(nedostaje fix_imported_linetypes.py^).
    echo  Kopiraj ponovno CIJELU mapu @PAYLOAD@ pokraj ove datoteke, iz:
    echo    @TOOLS@
    echo  ...pa probaj opet.
    echo.
    pause
    exit /b 1
)
rem --- gdje su objekti ----------------------------------------------
rem  Komplet je u !!!Digitalizacija\SurveyScraper5; objekti su u mapama
rem  pod !Za digitalizirat, jednu razinu iznad.
set "SCAN=%~dp0."
if exist "%~dp0@INTAKE@" for %%I in ("%~dp0@INTAKE@") do set "SCAN=%%~fI"
rem ------------------------------------------------------------------
echo ==================================================================
echo  KORAK 2 - dovrsavanje uvoza (da se grafika linija vidi)
echo ==================================================================
echo.
if not "%~1"=="" (
    python "%TOOLS%\fix_imported_linetypes.py" %* --force
    goto :kraj
)
echo  Kojem objektu dovrsavas uvoz? Upisi Redni broj objekta iz Speleo
echo  baze ^(broj u nazivu mape SB_^<broj^>_...^).
echo.
echo    * ako u mapi ima vise datoteka, pitat cu te koju zelis
echo    * samo Enter = odustani
echo.
echo  Trazim u: %SCAN%
echo.
set "SB="
set /p "SB=Redni broj: "
if not defined SB goto :odustao
echo.
python "%TOOLS%\fix_imported_linetypes.py" "%SCAN%" --sb %SB% --force
:kraj
echo.
echo ------------------------------------------------------------------
echo  Gotovo. Procitaj retke iznad:
echo    "OK ... _lt ..."   uspjeh: otvori _lt datoteku i u njoj crtaj.
echo    "BLOCKED"          kriva datoteka/korak: napravi sto pise.
echo    "ERROR"            nesto drugo: procitaj poruku.
echo.
echo  DALJE: kad si u _lt datoteci ispravio skicu i spremio je, pokreni
echo         KORAK 3 ^(csurvey_3_dovrsi_nacrt.bat^) - on radi gotov Nacrt.
echo ------------------------------------------------------------------
pause
exit /b 0

:odustao
echo.
echo  Odustao si - nista nije promijenjeno.
echo.
pause
exit /b 0
