@echo off
rem ------------------------------------------------------------------
rem  KORAK 1 od 3 - PRIPREMI TERENSKI CSX ZA cSURVEY
rem  Sirovi TopoDroid .csx  ->  _pp.csx spreman za uvoz (preimenuje
rem  simbole tako da prezive uvoz).
rem
rem    * Dvoklik: pita koje objekte pripremiti (Redni broj iz SB) i
rem      obradi samo njihove mape pod !Za digitalizirat
rem    * ...ili povuci jedan ili vise sirovih .csx na ovu ikonu
rem
rem  DOBIVAS: <ime>_pp.csx pokraj svakog ulaza -> TAJ uvozis u cSurvey.
rem  Datoteke koje vec zavrsavaju na _pp i spremljene cSurvey datoteke
rem  preskacu se automatski.
rem
rem  csurvey TDX komplet v@VERSION@ (@DATE@, commit @COMMIT@)
rem ------------------------------------------------------------------
rem --- find the tools -----------------------------------------------
rem  Generated by prod/build_csx_kit.py -- do not edit this file. Edit
rem  prod/csx_templates/ in the repo and re-publish.
rem
rem  Rung 1 is the normal case: the .py tools sit in the @PAYLOAD@ folder
rem  beside this .bat. Rung 2 covers a flat copy (tools next to the .bat),
rem  the later rungs keep older, scattered copies alive.
set "TOOLS="
if exist "%~dp0@PAYLOAD@\preprocess_tdx_csx.py" set "TOOLS=%~dp0@PAYLOAD@"
if not defined TOOLS if exist "%~dp0preprocess_tdx_csx.py" set "TOOLS=%~dp0"
if not defined TOOLS if exist "%LOCALAPPDATA%\CsxTools\tools_path.txt" (
    for /f "usebackq delims=" %%P in ("%LOCALAPPDATA%\CsxTools\tools_path.txt") do (
        if exist "%%P\preprocess_tdx_csx.py" set "TOOLS=%%P"
    )
)
if not defined TOOLS if defined CSX_TOOLS if exist "%CSX_TOOLS%\preprocess_tdx_csx.py" set "TOOLS=%CSX_TOOLS%"
if not defined TOOLS if exist "@TOOLS@\preprocess_tdx_csx.py" set "TOOLS=@TOOLS@"
if not defined TOOLS (
    echo.
    echo  Ne mogu pronaci alate ^(nedostaje preprocess_tdx_csx.py^).
    echo  Kopiraj ponovno CIJELU mapu @PAYLOAD@ pokraj ove datoteke, iz:
    echo    @TOOLS@
    echo  ...pa probaj opet.
    echo.
    pause
    exit /b 1
)
rem --- gdje su objekti ----------------------------------------------
rem  Komplet je u !!!Digitalizacija\SurveyScraper5; objekti su u mapama
rem  pod !Za digitalizirat, jednu razinu iznad.
set "SCAN=%~dp0."
if exist "%~dp0@INTAKE@" for %%I in ("%~dp0@INTAKE@") do set "SCAN=%%~fI"
rem ------------------------------------------------------------------
echo ==================================================================
echo  KORAK 1 - priprema terenskih csx datoteka za uvoz
echo ==================================================================
echo.
if not "%~1"=="" (
    python "%TOOLS%\preprocess_tdx_csx.py" %* --force
    goto :kraj
)
echo  Koje objekte pripremiti? Upisi Redni broj objekta iz Speleo baze
echo  ^(broj u nazivu mape SB_^<broj^>_...^).
echo.
echo    * vise brojeva odvoji razmakom, npr.  811 908
echo    * upisi  SVE  za sve objekte u !Za digitalizirat
echo    * samo Enter = odustani
echo.
echo  Trazim u: %SCAN%
echo.
set "SB="
set /p "SB=Redni broj(evi): "
if not defined SB goto :odustao
if /i "%SB%"=="SVE" (
    echo.
    echo  Pripremam SVE objekte pod !Za digitalizirat...
    echo.
    python "%TOOLS%\preprocess_tdx_csx.py" "%SCAN%" --force
) else (
    echo.
    python "%TOOLS%\preprocess_tdx_csx.py" "%SCAN%" --sb %SB% --force
)
:kraj
echo.
echo ------------------------------------------------------------------
echo  DALJE: otvori _pp.csx u cSurveyu, pa File ^> Save As. Zatim povuci
echo         tu spremljenu datoteku na csurvey_2_dovrsi_uvoz.bat.
echo         Prvo procitaj eventualne WARNING retke iznad.
echo ------------------------------------------------------------------
pause
exit /b 0

:odustao
echo.
echo  Odustao si - nista nije promijenjeno.
echo.
pause
exit /b 0
