@echo off
rem ------------------------------------------------------------------
rem  KORAK 9 (SAMO AKO ZATREBA) - OPORAVAK csx IZ PROJEKTNOG ZIP-a
rem  Koristi se kad je .csx s mobitela pokvaren: nema ga, ima 0 bajtova
rem  ili se otvori bez skice (bug TopoDroida 6.4.98+). Radi novi csx iz
rem  projektnog .zip-a.
rem
rem    * Dvoklik: pita koje objekte oporaviti (Redni broj iz SB) i
rem      obradi projektne zip-ove u njihovim mapama pod !Za digitalizirat
rem    * ...ili povuci jedan ili vise projektnih .zip na ovu ikonu
rem
rem  DOBIVAS, pokraj svakog zipa:
rem    <objekt>_recovered.csx     obnovljena datoteka s mobitela
rem    <objekt>_recovered_pp.csx  vec pripremljena -> NJU uvozis u cSurvey
rem
rem  Ovo za tebe odradi i KORAK 1, pa odmah idi na uvoz u cSurvey.
rem  Kad je csx ispravan, ovo NE trebas - koristi csurvey_1_pripremi_csx.bat.
rem
rem  NIJE korak u redoslijedu, nego popravak: broj 9 ga drzi na dnu
rem  popisa, izvan KORAKA 1-3.
rem
rem  csurvey TDX komplet v@VERSION@ (@DATE@, commit @COMMIT@)
rem ------------------------------------------------------------------
rem --- find the tools -----------------------------------------------
rem  Generated by prod/build_csx_kit.py -- do not edit this file. Edit
rem  prod/csx_templates/ in the repo and re-publish.
rem
rem  Rung 1 is the normal case: the .py tools sit in the @PAYLOAD@ folder
rem  beside this .bat. Rung 2 covers a flat copy (tools next to the .bat),
rem  the later rungs keep older, scattered copies alive.
set "TOOLS="
if exist "%~dp0@PAYLOAD@\tdx_zip_to_csx.py" set "TOOLS=%~dp0@PAYLOAD@"
if not defined TOOLS if exist "%~dp0tdx_zip_to_csx.py" set "TOOLS=%~dp0"
if not defined TOOLS if exist "%LOCALAPPDATA%\CsxTools\tools_path.txt" (
    for /f "usebackq delims=" %%P in ("%LOCALAPPDATA%\CsxTools\tools_path.txt") do (
        if exist "%%P\tdx_zip_to_csx.py" set "TOOLS=%%P"
    )
)
if not defined TOOLS if defined CSX_TOOLS if exist "%CSX_TOOLS%\tdx_zip_to_csx.py" set "TOOLS=%CSX_TOOLS%"
if not defined TOOLS if exist "@TOOLS@\tdx_zip_to_csx.py" set "TOOLS=@TOOLS@"
if not defined TOOLS (
    echo.
    echo  Ne mogu pronaci alate ^(nedostaje tdx_zip_to_csx.py^).
    echo  Kopiraj ponovno CIJELU mapu @PAYLOAD@ pokraj ove datoteke, iz:
    echo    @TOOLS@
    echo  ...pa probaj opet.
    echo.
    pause
    exit /b 1
)
rem --- gdje su objekti ----------------------------------------------
rem  Komplet je u !!!Digitalizacija\SurveyScraper5; objekti su u mapama
rem  pod !Za digitalizirat, jednu razinu iznad.
set "SCAN=%~dp0."
if exist "%~dp0@INTAKE@" for %%I in ("%~dp0@INTAKE@") do set "SCAN=%%~fI"
rem ------------------------------------------------------------------
echo ==================================================================
echo  KORAK 9 - oporavak csx-a iz projektnog zipa
echo ==================================================================
echo.
if not "%~1"=="" (
    python "%TOOLS%\tdx_zip_to_csx.py" %*
    goto :kraj
)
echo  Koje objekte oporaviti? Upisi Redni broj objekta iz Speleo baze
echo  ^(broj u nazivu mape SB_^<broj^>_...^).
echo.
echo    * vise brojeva odvoji razmakom, npr.  811 908
echo    * upisi  SVE  za sve objekte u !Za digitalizirat
echo    * samo Enter = odustani
echo.
echo  Trazim u: %SCAN%
echo.
set "SB="
set /p "SB=Redni broj(evi): "
if not defined SB goto :odustao
if /i "%SB%"=="SVE" (
    echo.
    echo  Oporavljam SVE objekte pod !Za digitalizirat...
    echo.
    python "%TOOLS%\tdx_zip_to_csx.py" "%SCAN%"
) else (
    echo.
    python "%TOOLS%\tdx_zip_to_csx.py" "%SCAN%" --sb %SB%
)
:kraj
echo.
echo ------------------------------------------------------------------
echo  DALJE: otvori _recovered_pp.csx u cSurveyu, pa File ^> Save As, i
echo         zatim KORAK 2 ^(csurvey_2_dovrsi_uvoz.bat^).
echo ------------------------------------------------------------------
pause
exit /b 0

:odustao
echo.
echo  Odustao si - nista nije promijenjeno.
echo.
pause
exit /b 0
