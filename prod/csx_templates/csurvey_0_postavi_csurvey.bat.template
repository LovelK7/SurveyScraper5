@echo off
rem ------------------------------------------------------------------
rem  KORAK 0 - POSTAVI cSURVEY (jednom po racunalu)
rem  Upise u cSurvey postavke programa koje 3N trazi (npr. faktor
rem  zagladivanja linija 0,01). One se ne spremaju u .csx datoteku nego
rem  u Windows, za svakog korisnika na svakom racunalu posebno.
rem
rem  KADA: jednom, prije prvog rada s cSurveyem na ovom racunalu - i
rem  opet ako KORAK 2 javi "cSurvey ... nije postavljen".
rem
rem  PRIJE: ZATVORI cSurvey. Ako je otvoren, ovo stane i to ti kaze.
rem
rem  KAKO: dvoklik. Nista ne pita.
rem
rem  csurvey TDX komplet v@VERSION@ (@DATE@, commit @COMMIT@)
rem ------------------------------------------------------------------
rem --- find the tools -----------------------------------------------
rem  Generated by prod/build_csx_kit.py -- do not edit this file. Edit
rem  prod/csx_templates/ in the repo and re-publish.
rem
rem  Rung 1 is the normal case: the .py tools sit in the @PAYLOAD@ folder
rem  beside this .bat. Rung 2 covers a flat copy (tools next to the .bat),
rem  the later rungs keep older, scattered copies alive.
set "TOOLS="
if exist "%~dp0@PAYLOAD@\csurvey_app_settings.py" set "TOOLS=%~dp0@PAYLOAD@"
if not defined TOOLS if exist "%~dp0csurvey_app_settings.py" set "TOOLS=%~dp0"
if not defined TOOLS if exist "%LOCALAPPDATA%\CsxTools\tools_path.txt" (
    for /f "usebackq delims=" %%P in ("%LOCALAPPDATA%\CsxTools\tools_path.txt") do (
        if exist "%%P\csurvey_app_settings.py" set "TOOLS=%%P"
    )
)
if not defined TOOLS if defined CSX_TOOLS if exist "%CSX_TOOLS%\csurvey_app_settings.py" set "TOOLS=%CSX_TOOLS%"
if not defined TOOLS if exist "@TOOLS@\csurvey_app_settings.py" set "TOOLS=@TOOLS@"
if not defined TOOLS (
    echo.
    echo  Ne mogu pronaci alate ^(nedostaje csurvey_app_settings.py^).
    echo  Kopiraj ponovno CIJELU mapu @PAYLOAD@ pokraj ove datoteke, iz:
    echo    @TOOLS@
    echo  ...pa probaj opet.
    echo.
    pause
    exit /b 1
)
rem ------------------------------------------------------------------
echo ==================================================================
echo  KORAK 0 - postavljanje cSurveya na ovom racunalu
echo ==================================================================
echo.
python "%TOOLS%\csurvey_app_settings.py" apply
echo.
echo ------------------------------------------------------------------
echo  Procitaj retke iznad:
echo    "OK"        gotovo - ovo vise ne moras pokretati na ovom racunalu.
echo    "BLOCKED"   zatvori cSurvey pa dvoklikni ovo ponovo.
echo    "ERROR"     nesto drugo: procitaj poruku.
echo.
echo  DALJE: KORAK 1 ^(csurvey_1_pripremi_csx.bat^).
echo ------------------------------------------------------------------
pause
exit /b 0
