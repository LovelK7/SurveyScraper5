@echo off
rem ------------------------------------------------------------------
rem  KORAK 3 od 3 - DOVRSI NACRT
rem  Od ispravljene _lt datoteke do gotovog Nacrta: upise mjerilo,
rem  strelicu sjevera i dubinu, ispise tlocrt i profil iz cSurveya bez
rem  dijaloga, i slozi oboje na sastavnicu -> SB_<broj>_nacrt.pdf.
rem
rem  NAPRAVI TEK KAD SI U cSURVEYU ISPRAVIO SKICU U _lt DATOTECI I
rem  SPREMIO JE.
rem
rem  KAKO - dva nacina:
rem    * Dvoklik: pita Redni broj objekta, pa ponudi datoteke iz njegove
rem      mape pod !Za digitalizirat da odaberes koju dovrsiti; usput te
rem      pita i za mjerilo/raspored ^(Enter = prijedlog^)
rem    * ...ili povuci ispravljenu _lt datoteku na ovu ikonu - tada ne
rem      pita nista i uzima prijedlog
rem
rem  DOBIVAS, u mapi objekta:
rem    <ime>_lt_fin.csx   dovrsena datoteka za cSurvey
rem    <ime>_plan.pdf     ispisani tlocrt
rem    <ime>_profile.pdf  ispisani profil
rem    <ime>_dimenzije.json  duljine i dubina
rem    SB_<broj>_nacrt.pdf   GOTOV NACRT
rem
rem  Ako cSurvey nije instaliran, korak stane poslije prve tocke i
rem  kaze ti kako ispisati rucno - _lt_fin datoteka je vec napravljena.
rem
rem  csurvey TDX komplet v@VERSION@ (@DATE@, commit @COMMIT@)
rem ------------------------------------------------------------------
rem --- find the tools -----------------------------------------------
rem  Generated by prod/build_csx_kit.py -- do not edit this file. Edit
rem  prod/csx_templates/ in the repo and re-publish.
rem
rem  Rung 1 is the normal case: the .py tools sit in the @PAYLOAD@ folder
rem  beside this .bat. Rung 2 covers a flat copy (tools next to the .bat),
rem  the later rungs keep older, scattered copies alive.
set "TOOLS="
if exist "%~dp0@PAYLOAD@\nacrt_finish.py" set "TOOLS=%~dp0@PAYLOAD@"
if not defined TOOLS if exist "%~dp0nacrt_finish.py" set "TOOLS=%~dp0"
if not defined TOOLS if exist "%LOCALAPPDATA%\CsxTools\tools_path.txt" (
    for /f "usebackq delims=" %%P in ("%LOCALAPPDATA%\CsxTools\tools_path.txt") do (
        if exist "%%P\nacrt_finish.py" set "TOOLS=%%P"
    )
)
if not defined TOOLS if defined CSX_TOOLS if exist "%CSX_TOOLS%\nacrt_finish.py" set "TOOLS=%CSX_TOOLS%"
if not defined TOOLS if exist "@TOOLS@\nacrt_finish.py" set "TOOLS=@TOOLS@"
if not defined TOOLS (
    echo.
    echo  Ne mogu pronaci alate ^(nedostaje nacrt_finish.py^).
    echo  Kopiraj ponovno CIJELU mapu @PAYLOAD@ pokraj ove datoteke, iz:
    echo    @TOOLS@
    echo  ...pa probaj opet.
    echo.
    pause
    exit /b 1
)
rem --- gdje su objekti ----------------------------------------------
rem  Komplet je u !!!Digitalizacija\SurveyScraper5; objekti su u mapama
rem  pod !Za digitalizirat, jednu razinu iznad.
set "SCAN=%~dp0."
if exist "%~dp0@INTAKE@" for %%I in ("%~dp0@INTAKE@") do set "SCAN=%%~fI"
rem ------------------------------------------------------------------
echo ==================================================================
echo  KORAK 3 - dovrsavanje Nacrta (od _lt datoteke do PDF-a)
echo ==================================================================
echo.
if not "%~1"=="" goto :povuceno

echo  Kojem objektu dovrsavas Nacrt? Upisi Redni broj objekta iz Speleo
echo  baze ^(broj u nazivu mape SB_^<broj^>_...^).
echo.
echo    * prije ovoga u cSurveyu ispravi skicu u _lt datoteci i spremi
echo    * ako u mapi ima vise datoteka, pitat cu te koju dovrsavas
echo    * zatim te pitam i za mjerilo/raspored - Enter uzima prijedlog
echo    * samo Enter = odustani
echo.
echo  Trazim u: %SCAN%
echo.
set "SB="
set /p "SB=Redni broj: "
if not defined SB goto :odustao
echo %SB%|findstr /r "^[0-9][0-9]* *$" >nul
if errorlevel 1 goto :nijebroj

echo.
echo  --- 1/3  priprema datoteke (mjerilo, sjever, dubina, postavke ispisa)
echo.
python "%TOOLS%\nacrt_finish.py" "%SCAN%" --sb %SB% --force
if errorlevel 1 goto :stalo

echo.
echo  --- 2/3  ispis tlocrta i profila iz cSurveya (bez dijaloga)
echo.
python "%TOOLS%\csurvey_driver.py" finish "%SCAN%" --sb %SB%
if errorlevel 1 goto :bez_csurveya

call :nacrt %SB%
goto :kraj

rem --- povucene datoteke: bez pitanja, uzima prijedlog ---------------
:povuceno
echo  Povukao si datoteku na ikonu - radim bez pitanja i uzimam
echo  predlozeno mjerilo i raspored.
:sljedeca
if "%~1"=="" goto :kraj
call :obradi "%~1"
shift
goto :sljedeca

rem  %1 = ispravljena _lt datoteka. Redni broj citam iz naziva mape
rem  objekta (SB_<broj>_...), jer ga drag-and-drop ne pita.
:obradi
echo.
echo ==================================================================
echo  %~nx1
echo ==================================================================
echo.
echo  --- 1/3  priprema datoteke (mjerilo, sjever, dubina, postavke ispisa)
echo.
python "%TOOLS%\nacrt_finish.py" "%~1" --yes --force
if errorlevel 1 (
    echo.
    echo  Priprema nije uspjela - procitaj poruku iznad. Preskacem ovu
    echo  datoteku.
    goto :eof
)
echo.
echo  --- 2/3  ispis tlocrta i profila iz cSurveya (bez dijaloga)
echo.
rem  %~dp1 zavrsava obrnutom kosom crtom, koja bi pojela zatvarajuci
rem  navodnik - zato je skidam prije nego je predam kao izlaznu mapu.
set "MAPAOBJ=%~dp1"
set "MAPAOBJ=%MAPAOBJ:~0,-1%"
python "%TOOLS%\csurvey_driver.py" finish "%~dpn1_fin%~x1" -o "%MAPAOBJ%"
if errorlevel 1 (
    call :rucniispis "%~n1_fin%~x1"
    goto :eof
)
set "BROJ="
set "MAPA="
for %%I in ("%~dp1.") do set "MAPA=%%~nxI"
for /f "tokens=1,2 delims=_" %%A in ("%MAPA%") do (
    if /i "%%A"=="SB" set "BROJ=%%B"
)
if not defined BROJ (
    echo.
    echo  Ne mogu iscitati Redni broj iz naziva mape ^(ocekujem SB_^<broj^>_...^).
    echo  PDF-ovi tlocrta i profila su napravljeni; zadnji korak pokreni
    echo  dvoklikom na ovu ikonu i upisi Redni broj.
    goto :eof
)
echo %BROJ%|findstr /r "^[0-9][0-9]* *$" >nul
if errorlevel 1 (
    echo.
    echo  "%BROJ%" iz naziva mape nije Redni broj. PDF-ovi su napravljeni;
    echo  zadnji korak pokreni dvoklikom na ovu ikonu.
    goto :eof
)
call :nacrt %BROJ%
goto :eof

rem --- 3/3 zadnji korak vodi cavedossier naredba iz ove iste mape ----
rem  Kit i cavedossier launcheri dijele prod mapu (prod/README.md), pa
rem  ga trazim pokraj sebe. Objavljivanje ostavlja samo najnoviju
rem  verziju vidljivom (starije idu u _arhiva\), a /o-n uzima zadnju
rem  po nazivu.
:nacrt
echo.
echo  --- 3/3  slaganje tlocrta i profila na sastavnicu (objekt %1)
echo.
set "CDNACRT="
for /f "delims=" %%L in ('dir /b /o-n "%~dp0cavedossier_nacrt_v*.bat" 2^>nul') do (
    if not defined CDNACRT set "CDNACRT=%~dp0%%L"
)
if not defined CDNACRT (
    echo  Ne mogu pronaci cavedossier_nacrt_v*.bat u ovoj mapi:
    echo    %~dp0
    echo.
    echo  Tlocrt i profil su ispisani i stoje u mapi objekta, ali ih
    echo  nemam cime sloziti na sastavnicu. Javi razvijatelju da u ovu
    echo  mapu objavi cavedossier naredbe.
    goto :eof
)
call "%CDNACRT%" %1
if errorlevel 1 (
    echo.
    echo  Slaganje na sastavnicu nije uspjelo - procitaj poruku iznad.
    echo  Tlocrt i profil su ispisani i stoje u mapi objekta.
    goto :eof
)
set "NACRT_OK=1"
goto :eof

rem  %1 = opis datoteke koju treba ispisati rukom
:rucniispis
echo.
echo ------------------------------------------------------------------
echo  cSurvey nije mogao ispisati ^(razlog je u poruci iznad^).
echo  Najcesce: cSurvey nije instaliran na ovom racunalu, nema pisaca
echo  "Microsoft Print to PDF", ili racun/ispis nije prosao.
echo.
echo  RUCNI IZLAZ - dovrsena datoteka je vec napravljena:
echo    1. otvori u cSurveyu:
echo       %~1
echo    2. File ^> Print
echo    3. ispisi posebno tlocrt, pa posebno profil
echo    4. za pisac odaberi  Microsoft Print to PDF
echo  Mjerilo, A4 i ostale postavke ispisa su vec upisane u datoteku -
echo  nemoj ih mijenjati, inace nacrt nece biti u tocnom mjerilu.
echo ------------------------------------------------------------------
goto :eof

:bez_csurveya
call :rucniispis "datoteku iz mape objekta koja zavrsava na _lt_fin"
pause
exit /b 0

:stalo
echo.
echo ------------------------------------------------------------------
echo  Priprema datoteke nije uspjela - procitaj poruku iznad.
echo    "ERROR"   procitaj recenicu iza; cesto je odabrana kriva
echo              datoteka ^(dovrsavas onu koja zavrsava na _lt^).
echo  Nista nije ispisano ni isporuceno.
echo ------------------------------------------------------------------
pause
exit /b 0

:kraj
echo.
echo ------------------------------------------------------------------
echo  U mapi objekta sada su:
echo    ..._lt_fin.csx/.csz   dovrsena datoteka za cSurvey
echo    ..._plan.pdf          ispisani tlocrt
echo    ..._profile.pdf       ispisani profil
echo    ..._dimenzije.json    duljine i dubina ^(za sastavnicu i zapisnik^)
rem  Zadnji redak obecava nacrt samo ako ga je zadnji korak stvarno
rem  napravio - inace operater trazi datoteku koje nema.
if defined NACRT_OK (
    echo    SB_^<broj^>_nacrt.pdf   GOTOV NACRT - tlocrt i profil na sastavnici
    echo.
    echo  DALJE: otvori SB_^<broj^>_nacrt.pdf i provjeri stranicu. Ako je
    echo         sve u redu, objekt je spreman za arhivara; ako ti raspored
    echo         ne odgovara, pokreni KORAK 3 ponovo i u izborniku odaberi
    echo         drugo mjerilo/raspored.
) else (
    echo.
    echo  Zadnji korak ^(slaganje na sastavnicu^) nije prosao - razlog je u
    echo  porukama iznad. Gotovog SB_^<broj^>_nacrt.pdf jos nema. Kad se to
    echo  rijesi, pokreni KORAK 3 ponovo - sve ostalo je vec napravljeno.
)
echo ------------------------------------------------------------------
pause
exit /b 0

:nijebroj
echo.
echo  "%SB%" nije Redni broj. Upisi samo znamenke, npr. 1103.
echo.
pause
exit /b 0

:odustao
echo.
echo  Odustao si - nista nije promijenjeno.
echo.
pause
exit /b 0
