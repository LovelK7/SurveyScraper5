@echo off
rem ------------------------------------------------------------------
rem  STEP 4 of 4 - FINISH THE IMPORT
rem  Turns the file you saved in cSurvey into the finished map file.
rem  (slope/gradient/etc. lines get their arrows/ticks; sizes; water)
rem
rem  DO THIS RIGHT AFTER "Save As" IN cSURVEY, BEFORE YOU DRAW ANYTHING.
rem
rem  HOW: drag the file you just saved and drop it on this icon.
rem       (both .csz and .csx are fine - whatever you saved)
rem
rem  YOU GET: a new file next to it whose name ends in _lt
rem       -> OPEN THAT _lt FILE in cSurvey and do all your drawing there.
rem
rem  If the black window says BLOCKED, you dragged a file that has not
rem  been imported into cSurvey yet - read what it tells you to do.
rem
rem  csurvey TDX kit v@VERSION@ (@DATE@, commit @COMMIT@)
rem ------------------------------------------------------------------
rem --- find the tools -----------------------------------------------
rem  Generated by prod/build_csx_kit.py -- do not edit this file. Edit
rem  prod/csx_templates/ in the repo and re-publish.
rem
rem  Rung 1 is the normal case: the .py tools sit in the @PAYLOAD@ folder
rem  beside this .bat. Rung 2 covers a flat copy (tools next to the .bat),
rem  the later rungs keep older, scattered copies alive.
set "TOOLS="
if exist "%~dp0@PAYLOAD@\fix_imported_linetypes.py" set "TOOLS=%~dp0@PAYLOAD@"
if not defined TOOLS if exist "%~dp0fix_imported_linetypes.py" set "TOOLS=%~dp0"
if not defined TOOLS if exist "%LOCALAPPDATA%\CsxTools\tools_path.txt" (
    for /f "usebackq delims=" %%P in ("%LOCALAPPDATA%\CsxTools\tools_path.txt") do (
        if exist "%%P\fix_imported_linetypes.py" set "TOOLS=%%P"
    )
)
if not defined TOOLS if defined CSX_TOOLS if exist "%CSX_TOOLS%\fix_imported_linetypes.py" set "TOOLS=%CSX_TOOLS%"
if not defined TOOLS if exist "@TOOLS@\fix_imported_linetypes.py" set "TOOLS=@TOOLS@"
if not defined TOOLS (
    echo.
    echo  Ne mogu pronaci alate ^(nedostaje fix_imported_linetypes.py^).
    echo  Kopiraj ponovno CIJELU mapu @PAYLOAD@ pokraj ove datoteke, iz:
    echo    @TOOLS@
    echo  ...pa probaj opet.
    echo.
    pause
    exit /b 1
)
rem ------------------------------------------------------------------
echo ==================================================================
echo  STEP 4 - finishing the import (making decorations show)
echo ==================================================================
echo.
if "%~1"=="" (
    echo  Nothing was dragged in.
    echo.
    echo  Do this: in Windows Explorer, find the file you just saved in
    echo  cSurvey ^(after "Save As"^), drag it with the mouse, and drop it
    echo  onto this csurvey_fix_tdx.bat icon.
) else (
    python "%TOOLS%\fix_imported_linetypes.py" %* --force
)
echo.
echo ------------------------------------------------------------------
echo  Done. Read the lines above:
echo    "OK ... _lt ..."   success: open the _lt file and draw in it.
echo    "BLOCKED"          wrong file/step: do what it tells you.
echo    "ERROR"            something else: read the message.
echo ------------------------------------------------------------------
pause
