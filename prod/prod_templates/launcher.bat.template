@echo off
rem SurveyScraper5 - nadzorna ploca v@VERSION@ - PROD launcher, generirano alatom
rem SurveyScraper5/prod/build_prod.py. NE UREDJIVATI RUCNO - promjene idu u
rem repo i objavljuju se novom verzijom.
rem Dvoklik: prva priprema (jednom po racunalu i verziji), pa otvara
rem nadzornu plocu u pregledniku. Ponovni dvoklik otvara istu plocu.
setlocal
chcp 65001 >nul
powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0v@VERSION@\bootstrap.ps1" -Version "@VERSION@"
