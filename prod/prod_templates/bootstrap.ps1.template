# SurveyScraper5 PROD bootstrap v@VERSION@ (Windows PowerShell 5.1)
# Generated by SurveyScraper5/prod/build_prod.py - do not edit on the Drive;
# changes go into the repo template and ship as a new version. Called by
# SurveyScraper5.bat, the one launcher (the dashboard, 2026-10-22).
#
# What it does on each double-click:
#   1. readable console (TrueType font - also fixes Croatian glyphs), run log
#   2. find the society archive root (probe upward for !Speleo_baza_SUE_*.xlsm)
#   3. first run / newer bundle.zip: install to %LOCALAPPDATA%\CaveDossier\v@VERSION@
#      (Python 3.11+ check, extract bundle, venv, pip install
#      .[osz,photos,geo,karta,sastavnica,sb-write] + playwright chromium, copy podaci\geo locally,
#      generate .env with the derived LOCAL_DRIVE_ROOT + shared georef login,
#      then 3N KORAK 0: cSurvey's app settings + a local cSurvey copy)
#   4. the dashboard: if this version's is already running, open it in the
#      browser; an older version's is asked to stop first. Otherwise start
#      `cavedossier gui` with no window (it stops itself 10 min after its last
#      page closes) and open it. %LOCALAPPDATA%\CaveDossier\gui.json is how a
#      running dashboard is found.
# Everything (setup steps, pip, stderr) is mirrored into
# %LOCALAPPDATA%\CaveDossier\logs\ - one file per run, plus gui_*.log for the
# dashboard itself.
param(
    [Parameter(Mandatory=$true)][string]$Version
)

$ErrorActionPreference = 'Stop'

# -- run log: everything W/Run-Logged emit lands here too ----------------
$script:LogFile = $null
$script:Warned = $false
$logDir = Join-Path $env:LOCALAPPDATA 'CaveDossier\logs'
try {
    New-Item -ItemType Directory -Force -Path $logDir | Out-Null
    $script:LogFile = Join-Path $logDir ("{0}_v{1}_{2}.log" -f 'nadzorna_ploca', $Version, (Get-Date -Format 'yyyyMMdd_HHmmss'))
    # keep the newest 60 logs so the folder never grows unbounded
    Get-ChildItem -Path $logDir -Filter '*.log' -File |
        Sort-Object LastWriteTime -Descending | Select-Object -Skip 60 |
        Remove-Item -Force -ErrorAction SilentlyContinue
} catch { $script:LogFile = $null }

function W([string]$Text) {
    Write-Host $Text
    if ($script:LogFile) {
        try { Add-Content -LiteralPath $script:LogFile -Value $Text -Encoding UTF8 } catch { }
    }
}

# The waiting snake (user, 2026-09-02): crawls whenever the running command
# goes quiet, erased the moment a real output line arrives.
$script:SnakeFrames = @('~~o>      ', ' ~~o>     ', '  ~~o>    ', '   ~~o>   ',
                        '    ~~o>  ', '     ~~o> ', '      ~~o>', '     ~~o> ',
                        '    ~~o>  ', '   ~~o>   ', '  ~~o>    ', ' ~~o>     ')

function Run-Logged([string]$Exe, [string[]]$Arguments) {
    # Runs the command with redirected streams so every line can be shown AND
    # written to the log; between lines the snake animates on its own line.
    # Async stream readers, polled - no PS eventing (unreliable in 5.1).
    $psi = New-Object System.Diagnostics.ProcessStartInfo
    $psi.FileName = $Exe
    $psi.Arguments = ($Arguments | ForEach-Object {
        if ($_ -match '\s') { '"' + $_ + '"' } else { $_ }
    }) -join ' '
    $psi.UseShellExecute = $false
    $psi.RedirectStandardOutput = $true
    $psi.RedirectStandardError = $true
    $psi.StandardOutputEncoding = [System.Text.Encoding]::UTF8
    $psi.StandardErrorEncoding = [System.Text.Encoding]::UTF8
    $psi.WorkingDirectory = (Get-Location).ProviderPath
    $proc = New-Object System.Diagnostics.Process
    $proc.StartInfo = $psi
    $proc.Start() | Out-Null

    $outTask = $proc.StandardOutput.ReadLineAsync()
    $errTask = $proc.StandardError.ReadLineAsync()
    $outDone = $false; $errDone = $false
    $frame = 0; $snakeShown = $false
    $wipe = "`r" + (' ' * 12) + "`r"

    while (-not ($outDone -and $errDone)) {
        $gotLine = $false
        foreach ($stream in 'out', 'err') {
            $task = if ($stream -eq 'out') { $outTask } else { $errTask }
            $done = if ($stream -eq 'out') { $outDone } else { $errDone }
            if ($done -or -not $task.IsCompleted) { continue }
            $line = $null
            try { $line = $task.Result } catch { $line = $null }
            if ($null -eq $line) {
                if ($stream -eq 'out') { $outDone = $true } else { $errDone = $true }
                continue
            }
            if ($snakeShown) { Write-Host $wipe -NoNewline; $snakeShown = $false }
            Write-Host $line
            if ($script:LogFile) {
                try { Add-Content -LiteralPath $script:LogFile -Value $line -Encoding UTF8 } catch { }
            }
            if ($stream -eq 'out') { $outTask = $proc.StandardOutput.ReadLineAsync() }
            else { $errTask = $proc.StandardError.ReadLineAsync() }
            $gotLine = $true
        }
        if (-not $gotLine) {
            $frame = ($frame + 1) % $script:SnakeFrames.Count
            Write-Host ("`r" + $script:SnakeFrames[$frame]) -NoNewline
            $snakeShown = $true
            Start-Sleep -Milliseconds 120
        }
    }
    if ($snakeShown) { Write-Host $wipe -NoNewline }
    $proc.WaitForExit()
    return $proc.ExitCode
}

function Warn([string]$Text) {
    $script:Warned = $true
    W $Text
}

# Success: the window closes by itself - unless something above deserves a read.
function Done-Exit {
    if ($script:Warned) { Pause-Exit 0 }
    exit 0
}

function Pause-Exit([int]$Code) {
    W ''
    if ($script:LogFile) { W "Zapis ovog pokretanja: $script:LogFile" }
    if ($Code -ne 0) { W 'Kod problema posalji tu datoteku razvijatelju.' }
    Write-Host ''
    Read-Host 'Pritisni Enter za izlaz' | Out-Null
    exit $Code
}

# -- readable console: a TrueType font also renders s/c/z with diacritics --
# (a raster-font window shows tiny text AND mangles UTF-8 glyphs). Fail-soft:
# inside Windows Terminal the call is simply ignored.
function Set-ConsoleFont([string]$Face, [int]$Size) {
    try {
        Add-Type -TypeDefinition @'
using System;
using System.Runtime.InteropServices;
public static class CaveDossierConsoleFont {
    [StructLayout(LayoutKind.Sequential, CharSet = CharSet.Unicode)]
    public struct CONSOLE_FONT_INFO_EX {
        public uint cbSize;
        public uint nFont;
        public short dwFontSizeX;
        public short dwFontSizeY;
        public int FontFamily;
        public int FontWeight;
        [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 32)]
        public string FaceName;
    }
    [DllImport("kernel32.dll", SetLastError = true)]
    public static extern IntPtr GetStdHandle(int nStdHandle);
    [DllImport("kernel32.dll", SetLastError = true, CharSet = CharSet.Unicode)]
    public static extern bool SetCurrentConsoleFontEx(
        IntPtr hConsoleOutput, bool bMaximumWindow, ref CONSOLE_FONT_INFO_EX info);
    public static void Apply(string face, short size) {
        CONSOLE_FONT_INFO_EX info = new CONSOLE_FONT_INFO_EX();
        info.cbSize = (uint)Marshal.SizeOf(info);
        info.FaceName = face;
        info.dwFontSizeX = 0;
        info.dwFontSizeY = size;
        info.FontFamily = 54;   // FF_MODERN | TMPF_TRUETYPE
        info.FontWeight = 400;
        SetCurrentConsoleFontEx(GetStdHandle(-11), false, ref info);
    }
}
'@
        [CaveDossierConsoleFont]::Apply($Face, [int16]$Size)
    } catch { }
}

try {
    Set-ConsoleFont 'Consolas' 20

    # Streams are redirected for logging, so Python would block-buffer its
    # output and the window would sit silent until the very end - unbuffered
    # keeps the lines flowing (and the snake only fills the real pauses).
    $env:PYTHONUNBUFFERED = '1'
    $env:PYTHONIOENCODING = 'utf-8'

    W "=== SurveyScraper5 - nadzorna ploca  (v$Version) ==="
    W ("racunalo: {0}  korisnik: {1}  vrijeme: {2}" -f $env:COMPUTERNAME, $env:USERNAME, (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'))
    W ''

    # -- locate the archive root -----------------------------------------
    # This script sits in <arhiva>\!!!Digitalizacija\SurveyScraper5\v<X>\.
    # Probing upward for the SB workbook beats counting levels: it survives
    # the SurveyScraper5 folder being moved within the archive.
    $ss5Dir = Split-Path -Parent $PSScriptRoot
    $driveRoot = $null
    $probe = $ss5Dir
    for ($i = 0; ($i -lt 6) -and $probe; $i++) {
        $hit = Get-ChildItem -Path $probe -Filter '!Speleo_baza_SUE_*.xlsm' -File -ErrorAction SilentlyContinue
        if ($hit) { $driveRoot = $probe; break }
        $probe = Split-Path -Parent $probe
    }
    if (-not $driveRoot) {
        W 'GRESKA: ne mogu pronaci korijen arhive (mapu koja sadrzi !Speleo_baza_SUE_*.xlsm).'
        W "Trazio sam prema gore od: $ss5Dir"
        W 'Je li Google Drive za radnu povrsinu pokrenut i sinkroniziran?'
        Pause-Exit 1
    }

    $installDir = Join-Path $env:LOCALAPPDATA "CaveDossier\v$Version"
    $venvPy     = Join-Path $installDir '.venv\Scripts\python.exe'
    $cli        = Join-Path $installDir '.venv\Scripts\cavedossier.exe'
    $bundleZip  = Join-Path $PSScriptRoot 'bundle.zip'
    $stampFile  = Join-Path $installDir '.installed_stamp'

    if (-not (Test-Path $bundleZip)) {
        W "GRESKA: nedostaje $bundleZip - mapa v$Version na Driveu je nepotpuna."
        Pause-Exit 1
    }

    # -- first run / updated bundle -> (re)install -----------------------
    $bundleStamp = (Get-Item $bundleZip).LastWriteTimeUtc.Ticks.ToString()
    $installedStamp = ''
    if (Test-Path $stampFile) {
        $installedStamp = [string](Get-Content $stampFile -TotalCount 1 -ErrorAction SilentlyContinue)
    }
    $needSetup = $false
    if (-not (Test-Path $cli)) {
        $needSetup = $true
        W 'Prva priprema na ovom racunalu - jednokratno, traje nekoliko minuta'
        W '(potreban je internet). Sljedeci put naredba krece odmah.'
    } elseif ($installedStamp -ne $bundleStamp) {
        $needSetup = $true
        W 'Na Driveu je noviji paket ove verzije - obnavljam lokalnu instalaciju...'
    }

    if ($needSetup) {
        W "Instalacija: $installDir"
        W ''

        # Python >= 3.11 (probes run through cmd so launcher noise stays quiet)
        $python = $null
        foreach ($cand in @('py -3.13', 'py -3.12', 'py -3.11', 'py -3', 'python')) {
            cmd /c "$cand -c ""import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)"" >nul 2>nul"
            if ($LASTEXITCODE -eq 0) { $python = $cand; break }
        }
        if (-not $python) {
            W 'GRESKA: Python 3.11 ili noviji nije pronadjen na ovom racunalu.'
            W ''
            W 'Instaliraj ga jednom (bilo koja od ove dvije opcije):'
            W '  1) https://www.python.org/downloads/  ->  Download Python'
            W '     (u instalacijskom prozoru OBAVEZNO kvacica "Add python.exe to PATH")'
            W '  2) ili u terminalu:  winget install -e --id Python.Python.3.12'
            W ''
            W 'Nakon instalacije ponovno dvoklikni ovu naredbu.'
            Pause-Exit 1
        }
        W "Python: $python"

        New-Item -ItemType Directory -Force -Path $installDir | Out-Null
        W 'Raspakiravam paket...'
        Expand-Archive -Path $bundleZip -DestinationPath $installDir -Force

        if (-not (Test-Path $venvPy)) {
            W 'Stvaram Python okruzenje (.venv)...'
            # $python is "exe [arg]" ('py -3.11' / 'python') - split for Run-Logged
            $pyParts = $python -split ' '
            $pyArgs = @()
            if ($pyParts.Count -gt 1) { $pyArgs = $pyParts[1..($pyParts.Count - 1)] }
            $venvExit = Run-Logged $pyParts[0] ($pyArgs + @('-m', 'venv', "$installDir\.venv"))
            if ($venvExit -ne 0) {
                W 'GRESKA: stvaranje .venv nije uspjelo.'
                Pause-Exit 1
            }
        }

        W 'Instaliram pakete (pip; ovo je najduzi korak)...'
        Push-Location $installDir
        $pipExit = Run-Logged $venvPy @('-m', 'pip', 'install', '--disable-pip-version-check', '-e', '.[osz,photos,geo,karta,sastavnica,sb-write]')
        Pop-Location
        if ($pipExit -ne 0) {
            W ''
            W 'GRESKA: pip instalacija nije uspjela. Najcesci uzrok: nema interneta.'
            W 'Provjeri vezu i ponovno dvoklikni naredbu - nastavlja gdje je stala.'
            Pause-Exit 1
        }

        # Browser for the isjecak karte (georef.hr) flow - prod machines run it
        # themselves since v1.2 (user, 2026-09-02). A failed download is not
        # fatal: prefill degrades to its "excerpt not collected" note.
        W 'Preuzimam preglednik za isjecak karte (~150 MB, jednokratno)...'
        $pwExit = Run-Logged $venvPy @('-m', 'playwright', 'install', 'chromium')
        if ($pwExit -ne 0) {
            Warn 'UPOZORENJE: preuzimanje preglednika nije uspjelo - isjecak karte se'
            Warn 'nece moci dohvacati s ovog racunala. Sve ostalo radi normalno;'
            Warn 'sljedeca prva priprema (nova verzija) pokusat ce ponovno.'
        }

        # Local copy of the shared geodata (locality + elevation finders).
        # robocopy /XO = incremental; a rerun after an interrupted copy heals.
        $geoSrc = Join-Path $ss5Dir 'podaci\geo'
        if (Test-Path $geoSrc) {
            W 'Kopiram geopodatke s Drivea (~280 MB, jednokratno)...'
            $roboExit = Run-Logged 'robocopy' @($geoSrc, (Join-Path $installDir 'data\geo'), '/E', '/XO', '/R:2', '/W:5', '/NJH', '/NJS', '/NDL', '/NFL', '/NP')
            if ($roboExit -ge 8) {
                Warn 'UPOZORENJE: kopiranje geopodataka nije proslo u cijelosti -'
                Warn 'lokacija i kota mozda nece biti ispunjene. Ostalo radi normalno.'
            }
        } else {
            Warn "UPOZORENJE: $geoSrc ne postoji - preskacem geopodatke."
        }

        Set-Content -Path $stampFile -Value $bundleStamp -Encoding Ascii
        W 'Priprema gotova.'
        W ''
    }

    # -- .env: per-machine facts, regenerated whenever missing -----------
    $envFile = Join-Path $installDir '.env'
    if (-not (Test-Path $envFile)) {
        New-Item -ItemType Directory -Force -Path (Join-Path $installDir 'sb-fallback') | Out-Null
        $envLines = @(
            '# Generirano automatski (bootstrap.ps1) - po potrebi obrisi pa se stvara iznova.',
            "LOCAL_DRIVE_ROOT=$driveRoot",
            '# Lokalna rezervna kopija SB - cita se kad je radna knjiga zauzeta/nedostupna.',
            'SB_SANDBOX_PATH=sb-fallback/SB_kopija.xlsm'
        )
        # Shared society georef.hr login (injected at build time from the dev
        # .env) so `osz prefill` can collect a missing isjecak karte itself.
        $georefUrl = '@GEOREF_BASE_URL@'
        if ($georefUrl.Length -gt 0) {
            $envLines += '# georef.hr - zajednicki racun drustva (za isjecak karte).'
            $envLines += "GEOREF_BASE_URL=$georefUrl"
            $envLines += 'GEOREF_USERNAME=@GEOREF_USERNAME@'
            $envLines += 'GEOREF_PASSWORD=@GEOREF_PASSWORD@'
        }
        Set-Content -Path $envFile -Value $envLines -Encoding Ascii
    }

    # -- 3N KORAK 0, once per install (needs the .env above) ----------------
    # Formerly csurvey_0_postavi_csurvey.bat: cSurvey's app settings into the
    # registry, and a local copy of the Drive's cSurvey with a desktop shortcut
    # (opened by hand from G: it crashes). Fail-soft: a cSurvey left open only
    # blocks the settings; the dashboard's 3N page has both as buttons.
    $toolsDir = Join-Path $installDir 'csx-alati'
    if ($needSetup -and (Test-Path (Join-Path $toolsDir 'csurvey_app_settings.py'))) {
        W 'Postavljam cSurvey na ovom racunalu (KORAK 0)...'
        Push-Location $installDir
        $k0Settings = Run-Logged $venvPy @((Join-Path $toolsDir 'csurvey_app_settings.py'), 'apply')
        $k0Local = Run-Logged $venvPy @((Join-Path $toolsDir 'csurvey_local.py'), 'install')
        Pop-Location
        if (($k0Settings -ne 0) -or ($k0Local -ne 0)) {
            Warn 'UPOZORENJE: cSurvey nije do kraja postavljen (je li bio otvoren?).'
            Warn 'Ostalo radi. Na nadzornoj ploci: 3N > "cSurvey na ovom racunalu".'
        }
        W ''
    }

    # -- the dashboard: reuse the running one, or start it hidden ---------
    # The page's own server, on 127.0.0.1 only. Not a proxy's business.
    [System.Net.WebRequest]::DefaultWebProxy = $null
    $stateFile = Join-Path $env:LOCALAPPDATA 'CaveDossier\gui.json'

    function Read-GuiState {
        if (-not (Test-Path $stateFile)) { return $null }
        try { return (Get-Content -LiteralPath $stateFile -Raw -Encoding UTF8 | ConvertFrom-Json) }
        catch { return $null }
    }

    # POST /api/<verb> with the server's token; the HTTP status, 0 = no answer.
    function Invoke-Gui($State, [string]$Verb) {
        try {
            $r = Invoke-WebRequest -UseBasicParsing -Method Post -Uri ($State.url + 'api/' + $Verb) -Headers @{ 'X-Token' = [string]$State.token } -ContentType 'application/json' -Body '{}' -TimeoutSec 5
            return [int]$r.StatusCode
        } catch [System.Net.WebException] {
            if ($_.Exception.Response) { return [int]$_.Exception.Response.StatusCode }
            return 0
        } catch { return 0 }
    }

    $running = Read-GuiState
    if ($running -and ((Invoke-Gui $running 'ping') -eq 200)) {
        if ([string]$running.root -eq $installDir) {
            W "Nadzorna ploca vec radi - otvaram je: $($running.url)"
            Start-Process $running.url
            Done-Exit
        }
        W 'Radi starija verzija nadzorne ploce - zaustavljam je...'
        if ((Invoke-Gui $running 'shutdown') -eq 409) {
            W 'Starija verzija jos izvrsava posao. Otvaram nju; kad posao zavrsi,'
            W 'zatvori je (gumb Zatvori gore desno) pa ponovno dvoklikni SurveyScraper5.bat.'
            Start-Process $running.url
            Pause-Exit 0
        }
        Start-Sleep -Seconds 2
    }

    $stamp = Get-Date -Format 'yyyyMMdd_HHmmss'
    $outLog = Join-Path $logDir "gui_v$($Version)_$stamp.log"
    $errLog = Join-Path $logDir "gui_v$($Version)_$stamp.err.log"
    # cavedossier.exe and the venv python.exe both hand over to a child
    # process, so the server is recognised by when it wrote gui.json, not by pid.
    $launched = [DateTimeOffset]::UtcNow.ToUnixTimeSeconds() - 1
    W 'Pokrecem nadzornu plocu...'
    $proc = Start-Process -FilePath $cli -ArgumentList @('gui', '--no-browser', '--state-file', ('"' + $stateFile + '"'), '--idle-minutes', '10') -WorkingDirectory $installDir -WindowStyle Hidden -RedirectStandardOutput $outLog -RedirectStandardError $errLog -PassThru

    $ready = $null
    $deadline = (Get-Date).AddSeconds(90)
    while ((Get-Date) -lt $deadline) {
        Start-Sleep -Milliseconds 500
        $s = Read-GuiState
        if ($s -and ([double]$s.started -ge $launched) -and ((Invoke-Gui $s 'ping') -eq 200)) { $ready = $s; break }
        if ($proc.HasExited) { break }
    }
    if (-not $ready) {
        W 'GRESKA: nadzorna ploca se nije pokrenula. Zadnje poruke:'
        foreach ($f in @($errLog, $outLog)) {
            if (Test-Path $f) { Get-Content -LiteralPath $f -Tail 25 -Encoding UTF8 | ForEach-Object { W $_ } }
        }
        Pause-Exit 1
    }
    W "Nadzorna ploca: $($ready.url)"
    W 'Radi u pozadini i sama se zaustavi 10 min nakon sto zatvoris sve njezine kartice.'
    Start-Process $ready.url
    Done-Exit
}
catch {
    W ''
    W "NEOCEKIVANA GRESKA: $($_.Exception.Message)"
    W $_.ScriptStackTrace
    Pause-Exit 1
}
